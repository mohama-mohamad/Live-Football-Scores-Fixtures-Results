{
  // إعدادات Cloudflare Worker: يخدم التطبيق (الملفات الثابتة) + واجهة /api + مهمة التنبيهات الدورية
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "koora-live",
  "main": "src/index.ts",
  "workers_dev": true,
  // تشغيل الـ Worker قرب أوروبا الغربية: طلبات API-Football من بعض مراكز Cloudflare (مثل BOM)
  // تُرفض لأن عناوينها مشتركة بين كثير من المستخدمين
  "placement": { "region": "aws:eu-west-3" },
  // ربط الـ Worker بنفسه: المهمة الدورية تستدعي نفسها عبره فتعمل في الموقع المحدد أعلاه
  // (إعداد placement لا ينطبق على المهمة الدورية مباشرة)
  "services": [{ "binding": "SELF", "service": "koora-live" }],
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "../app/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  // كل دقيقة: يفحص المباريات الجارية ويرسل التنبيهات (مع احترام حدّ الطلبات اليومي)
  "triggers": { "crons": ["* * * * *"] },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "koora-live",
      // قاعدة بيانات D1 في حساب Cloudflare (أُنشئت مسبقاً)
      "database_id": "980f0da1-b901-4ccd-8cec-ea8391030f79",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    // mock = بيانات تجريبية بلا مفتاح | api-football = بيانات حقيقية (يتطلب السر API_FOOTBALL_KEY)
    "PROVIDER": "mock",
    // حدّ الطلبات اليومي لخطة API-Football (المجانية = 100)
    "DAILY_REQUEST_LIMIT": "100",
    // أقل فاصل بالثواني بين كل فحص للمباريات المباشرة
    "LIVE_POLL_SECONDS": "60",
    // وسيلة تواصل لخدمات التنبيهات (Apple/Google): بريد mailto: أو رابط https:
    "VAPID_SUBJECT": "https://github.com/mohama-mohamad/Live-Football-Scores-Fixtures-Results"
  },
  "observability": { "enabled": true }
}
